#!/bin/sh
set -eu

# Configure developer defaults inside the live-build chroot:
# - Default shell: zsh for newly created users
# - Rootless Podman subuid/subgid mapping for the live user
# - Enable SDDM (X11-only) and configure live-session autologin (removed post-install)

if [ -x /usr/bin/zsh ]; then
    if [ -f /etc/default/useradd ]; then
        sed -i 's|^SHELL=.*|SHELL=/usr/bin/zsh|' /etc/default/useradd
    fi
    if [ -f /etc/adduser.conf ]; then
        sed -i 's|^DSHELL=.*|DSHELL=/usr/bin/zsh|' /etc/adduser.conf
    fi
fi

# Ensure subuid/subgid files exist and contain a range for the live 'alx' user
touch /etc/subuid /etc/subgid
if ! grep -q '^alx:' /etc/subuid; then
    printf 'alx:100000:65536\n' >> /etc/subuid
fi
if ! grep -q '^alx:' /etc/subgid; then
    printf 'alx:100000:65536\n' >> /etc/subgid
fi

# Live-ISO-only SDDM autologin into Awesome WM (Calamares removes this file on install)
mkdir -p /etc/sddm.conf.d
cat > /etc/sddm.conf.d/99-alx-live-autologin.conf <<'EOF'
[Autologin]
User=alx
Session=awesome.desktop
EOF

# Enable SDDM when installed
if command -v systemctl >/dev/null 2>&1; then
    if [ -f /usr/lib/systemd/system/sddm.service ] || [ -f /lib/systemd/system/sddm.service ]; then
        systemctl enable sddm.service || true
    fi
fi
