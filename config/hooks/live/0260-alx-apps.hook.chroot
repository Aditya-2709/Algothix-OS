#!/bin/sh
set -eu

# Install Brave Browser (replacing Firefox ESR) and Visual Studio Code
# from their official Debian APT repositories during live-build chroot stage.

mkdir -p /usr/share/keyrings

# 1. Brave Browser official APT repository
curl -fsSLo /usr/share/keyrings/brave-browser-archive-keyring.gpg \
    https://brave-browser-apt-release.s3.brave.com/brave-browser-archive-keyring.gpg
curl -fsSLo /etc/apt/sources.list.d/brave-browser-release.sources \
    https://brave-browser-apt-release.s3.brave.com/brave-browser.sources
chmod 0644 /usr/share/keyrings/brave-browser-archive-keyring.gpg \
    /etc/apt/sources.list.d/brave-browser-release.sources

# 2. Visual Studio Code official APT repository
curl -fsSL https://packages.microsoft.com/keys/microsoft.asc \
    | gpg --dearmor > /usr/share/keyrings/microsoft.gpg
chmod 0644 /usr/share/keyrings/microsoft.gpg
printf 'deb [arch=amd64 signed-by=/usr/share/keyrings/microsoft.gpg] https://packages.microsoft.com/repos/code stable main\n' \
    > /etc/apt/sources.list.d/vscode.list
chmod 0644 /etc/apt/sources.list.d/vscode.list

apt-get update -qq
apt-get install -y --no-install-recommends brave-browser code
