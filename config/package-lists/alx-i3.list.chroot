# Algothix OS (ALX) Lite — M2 ALX-i3 Desktop Layer (Debian 13 trixie amd64)
# Minimal Xorg + LightDM + i3 session with picom installed but disabled by default.

# Minimal Xorg
xserver-xorg-core
xinit
xserver-xorg-input-libinput
x11-xserver-utils
dbus-x11

# Display Manager
lightdm
lightdm-gtk-greeter

# ALX-i3 Window Manager & Utilities (FR-2.1)
i3-wm
i3status
rofi
feh
dunst
pcmanfm
network-manager-applet
xclip
picom
rxvt-unicode
xterm

# Theme, Icons, and Fonts (FR-2.5)
arc-theme
papirus-icon-theme
fonts-jetbrains-mono
fonts-noto-core
librsvg2-common
