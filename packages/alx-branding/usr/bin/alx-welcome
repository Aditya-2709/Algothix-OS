#!/bin/sh
set -eu

# Algothix OS (ALX) Lite — First-boot terminal welcome (FR-6.3)
VERSION="1.1.0"
PROFILE_FILE="${ALX_PROFILE_FILE:-/etc/alx/profile}"

case "${1:-}" in
    -h|--help)
        printf 'Usage: alx-welcome [--help|--version]\n'
        printf 'Display the Algothix OS (ALX) Lite quick-start welcome.\n'
        exit 0
        ;;
    -v|--version)
        printf 'alx-welcome %s\n' "${VERSION}"
        exit 0
        ;;
    "")
        ;;
    *)
        printf 'alx-welcome: unknown option: %s\n' "$1" >&2
        exit 2
        ;;
esac

PROFILE="pending (run: sudo alx-tune)"
if [ -r "${PROFILE_FILE}" ]; then
    PROFILE="$(head -n 1 "${PROFILE_FILE}" | tr -d '[:space:]')"
fi

cat <<EOF
====================================================================
  Welcome to Algothix OS (ALX) Lite 1.1
  Hardware profile: ${PROFILE}
====================================================================

  Quick-start commands:
    alx-setup list       Install language toolchains (python, node, go, rust, cpp...)
    alx-link pair        Pair with another ALX machine (Tailscale/WireGuard, SSH, Syncthing)
    alx-doctor           Check RAM, zram, disk, and service health
    Super + ?            Open the Awesome WM keybinding cheat-sheet

  Run 'alx-welcome' anytime to see this message again.
====================================================================
EOF
