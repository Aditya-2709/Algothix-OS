[global]
    font = Noto Sans 9
    frame_width = 1
    frame_color = "#38bdf8"
    separator_color = frame
    padding = 8
    horizontal_padding = 10
    corner_radius = 0
    origin = top-right
    offset = 10x32
    timeout = 5

[urgency_low]
    background = "#0f172a"
    foreground = "#cbd5e1"

[urgency_normal]
    background = "#0f172a"
    foreground = "#f8fafc"

[urgency_critical]
    background = "#7f1d1d"
    foreground = "#f8fafc"
    frame_color = "#ef4444"
    timeout = 0
