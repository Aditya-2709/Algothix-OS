#!/usr/bin/env bash
set -euo pipefail

# Algothix OS (ALX) Lite — Lightweight Cross-Device Layer (CHANGE-001)
# Stack: Tailscale (default) or WireGuard, Taildrop or scp/rsync, Syncthing,
#        xclip + notify-send over SSH, SSH + tmux + mosh remote runs.

VERSION="1.1.0"
CONF_FILE="${ALX_LINK_CONF:-/etc/alx/link.conf}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ -n "${ALX_LINK_CORE:-}" ]; then
    CORE_PY="${ALX_LINK_CORE}"
elif [ -x /usr/lib/alx-link/alx-link-core.py ]; then
    CORE_PY="/usr/lib/alx-link/alx-link-core.py"
else
    CORE_PY="${SCRIPT_DIR}/../lib/alx-link/alx-link-core.py"
fi

SSH_CMD="${ALX_LINK_SSH_CMD:-ssh}"
SCP_CMD="${ALX_LINK_SCP_CMD:-scp}"
RSYNC_CMD="${ALX_LINK_RSYNC_CMD:-rsync}"
TAILSCALE_CMD="${ALX_LINK_TAILSCALE_CMD:-tailscale}"

network="tailscale"
SYNC_DIR="ALX-Sync"
PAIR_PORT=47470
PAIR_TIMEOUT=120

if [ -r "${CONF_FILE}" ]; then
    # shellcheck disable=SC1090
    source "${CONF_FILE}"
fi

ALX_LINK_NETWORK="${ALX_LINK_NETWORK:-${network}}"
export ALX_LINK_NETWORK SYNC_DIR PAIR_PORT PAIR_TIMEOUT

usage() {
    cat <<'EOF'
Usage: alx-link <command> [OPTIONS]

Lightweight cross-device workspace layer for Algothix OS (ALX) Lite.

Commands:
  pair --listen [--code <PIN>] [--port <P>]
      Listen for an incoming pairing request with a 6-digit PIN.
  pair <peer> --code <PIN> [--port <P>]
      Pair with a listening ALX peer (brings up Tailscale/WireGuard, exchanges
      SSH keys, shares ~/ALX-Sync via Syncthing, configures scoped ufw rules).
  send <file> [peer]
      Send file via Taildrop (on Tailscale) or rsync/scp over SSH (WireGuard).
  clip [peer]
      Push local X11 clipboard (xclip) to <peer> over SSH (sets DISPLAY/XAUTHORITY).
  notify <peer> <message...>
      Send a desktop notification (notify-send) to <peer> over SSH (sets DBUS).
  run <peer> -- <command...>
      Run a command remotely on <peer> inside a tmux session over SSH.
  status [--json]
      Show paired peers, online state, and Tailscale/WireGuard/SSH/Syncthing health.
  unpair <peer>
      Cleanly and idempotently remove SSH keys, config, and Syncthing device.

Options:
  -v, --version  Show version information
  -h, --help     Show this help message
EOF
}

default_peer() {
    local pdir="${HOME}/.config/alx-link/peers"
    if [ -d "${pdir}" ]; then
        local first
        first="$(find "${pdir}" -maxdepth 1 -name '*.json' 2>/dev/null | sort | head -n 1)"
        if [ -n "${first}" ]; then
            basename "${first}" .json
            return 0
        fi
    fi
    return 1
}

ensure_network_up() {
    if [ "${ALX_LINK_SKIP_NET:-0}" = "1" ]; then
        return 0
    fi
    if [ "${ALX_LINK_NETWORK}" = "tailscale" ]; then
        if command -v "${TAILSCALE_CMD}" >/dev/null 2>&1; then
            if ! "${TAILSCALE_CMD}" status >/dev/null 2>&1; then
                echo "ALX Link: bringing up Tailscale (run 'sudo tailscale up' if auth is needed)..."
                "${TAILSCALE_CMD}" up >/dev/null 2>&1 || true
            fi
        fi
    elif [ "${ALX_LINK_NETWORK}" = "wireguard" ]; then
        if command -v wg-quick >/dev/null 2>&1 && [ -f /etc/wireguard/wg0.conf ] && [ ! -d /sys/class/net/wg0 ]; then
            echo "ALX Link: bringing up WireGuard interface wg0..."
            sudo wg-quick up wg0 || true
        fi
    fi
}

apply_ufw_mesh_rules() {
    if [ "${ALX_LINK_SKIP_UFW:-0}" = "1" ] || ! command -v ufw >/dev/null 2>&1; then
        return 0
    fi
    if [ "$(id -u)" -ne 0 ]; then
        return 0
    fi
    local iface="tailscale0"
    [ "${ALX_LINK_NETWORK}" = "wireguard" ] && iface="wg0"
    ufw allow in on "${iface}" to any port 22 proto tcp comment "alx-link ssh" >/dev/null 2>&1 || true
    ufw allow in on "${iface}" to any port 22000 proto tcp comment "alx-link syncthing" >/dev/null 2>&1 || true
    ufw allow in on "${iface}" to any port 22000 proto udp comment "alx-link syncthing" >/dev/null 2>&1 || true
    ufw allow in on "${iface}" to any port 21027 proto udp comment "alx-link syncthing discovery" >/dev/null 2>&1 || true
}

if [ "$#" -eq 0 ]; then
    usage >&2
    exit 2
fi

case "$1" in
    -h|--help)
        usage
        exit 0
        ;;
    -v|--version)
        printf 'alx-link %s\n' "${VERSION}"
        exit 0
        ;;
    pair)
        shift
        if [ "$#" -eq 0 ]; then
            echo "alx-link pair: specify '--listen' or '<peer> --code <PIN>'" >&2
            exit 2
        fi
        ensure_network_up
        if [ "$1" = "--listen" ]; then
            shift
            python3 "${CORE_PY}" pair-listen --port "${PAIR_PORT}" --timeout "${PAIR_TIMEOUT}" "$@"
        else
            python3 "${CORE_PY}" pair-connect "$@"
        fi
        apply_ufw_mesh_rules
        ;;
    unpair)
        shift
        [ "$#" -eq 1 ] || { echo "Usage: alx-link unpair <peer>" >&2; exit 2; }
        exec python3 "${CORE_PY}" unpair "$1"
        ;;
    status)
        shift
        exec python3 "${CORE_PY}" status "$@"
        ;;
    send)
        shift
        [ "$#" -ge 1 ] || { echo "Usage: alx-link send <file> [peer]" >&2; exit 2; }
        FILE_PATH="$1"
        PEER="${2:-}"
        if [ ! -e "${FILE_PATH}" ]; then
            echo "alx-link send: file not found: ${FILE_PATH}" >&2
            exit 1
        fi
        if [ -z "${PEER}" ]; then
            PEER="$(default_peer || true)"
        fi
        if [ -z "${PEER}" ]; then
            echo "alx-link send: no peer specified and no paired peers found." >&2
            exit 2
        fi
        if [ "${ALX_LINK_NETWORK}" = "tailscale" ] && command -v "${TAILSCALE_CMD}" >/dev/null 2>&1; then
            exec "${TAILSCALE_CMD}" file cp "${FILE_PATH}" "${PEER}:"
        elif command -v "${RSYNC_CMD}" >/dev/null 2>&1; then
            exec "${RSYNC_CMD}" -az --progress -e "${SSH_CMD}" "${FILE_PATH}" "${PEER}:~/${SYNC_DIR}/"
        else
            exec "${SCP_CMD}" -r "${FILE_PATH}" "${PEER}:~/${SYNC_DIR}/"
        fi
        ;;
    clip)
        shift
        PEER="${1:-}"
        if [ -z "${PEER}" ]; then
            PEER="$(default_peer || true)"
        fi
        if [ -z "${PEER}" ]; then
            echo "Usage: alx-link clip [peer]" >&2
            exit 2
        fi
        REMOTE_CLIP_SH='
            D="${DISPLAY:-}"
            if [ -z "$D" ]; then
                sock="$(ls /tmp/.X11-unix/X* 2>/dev/null | head -n 1 || true)"
                [ -n "$sock" ] && D=":${sock##*X}" || D=":0"
            fi
            XA="${XAUTHORITY:-$HOME/.Xauthority}"
            if [ ! -r "$XA" ]; then
                cand="$(ls /run/user/"$(id -u)"/xauth_* 2>/dev/null | head -n 1 || true)"
                [ -n "$cand" ] && XA="$cand"
            fi
            DISPLAY="$D" XAUTHORITY="$XA" xclip -i -selection clipboard
        '
        if [ -n "${ALX_LINK_CLIP_TEXT:-}" ]; then
            printf '%s' "${ALX_LINK_CLIP_TEXT}" | "${SSH_CMD}" "${PEER}" "${REMOTE_CLIP_SH}"
        elif command -v xclip >/dev/null 2>&1; then
            xclip -o -selection clipboard | "${SSH_CMD}" "${PEER}" "${REMOTE_CLIP_SH}"
        else
            echo "alx-link clip: xclip is required." >&2
            exit 1
        fi
        echo "Clipboard pushed to ${PEER}."
        ;;
    notify)
        shift
        [ "$#" -ge 2 ] || { echo "Usage: alx-link notify <peer> <message...>" >&2; exit 2; }
        PEER="$1"
        shift
        MSG="$*"
        REMOTE_NOTIFY_SH='
            D="${DISPLAY:-:0}"
            DB="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/$(id -u)/bus}"
            msg="$(cat)"
            DISPLAY="$D" DBUS_SESSION_BUS_ADDRESS="$DB" notify-send "ALX Link" "$msg"
        '
        printf '%s' "${MSG}" | "${SSH_CMD}" "${PEER}" "${REMOTE_NOTIFY_SH}"
        echo "Notification sent to ${PEER}."
        ;;
    run)
        shift
        [ "$#" -ge 3 ] || { echo "Usage: alx-link run <peer> -- <command...>" >&2; exit 2; }
        PEER="$1"
        shift
        if [ "$1" != "--" ]; then
            echo "Usage: alx-link run <peer> -- <command...>" >&2
            exit 2
        fi
        shift
        REMOTE_CMD="$*"
        exec "${SSH_CMD}" -t "${PEER}" "tmux new-session -A -s alx-run \"${REMOTE_CMD}\""
        ;;
    *)
        echo "alx-link: unknown command: $1" >&2
        exit 2
        ;;
esac
