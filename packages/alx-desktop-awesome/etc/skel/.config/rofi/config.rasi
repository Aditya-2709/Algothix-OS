configuration {
    modi: "drun,run,window";
    font: "JetBrains Mono 10";
    show-icons: false;
    terminal: "urxvt";
}

* {
    bg: #0B0D10;
    bg-alt: #13171D;
    fg: #E6EDF3;
    accent: #3DDC97;
    background-color: @bg;
    text-color: @fg;
}

window {
    border: 1px;
    border-color: @accent;
    padding: 8px;
    width: 40%;
}

element selected {
    background-color: @bg-alt;
    text-color: @accent;
}
