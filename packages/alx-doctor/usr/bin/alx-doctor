#!/usr/bin/env bash
set -euo pipefail

# Algothix OS (ALX) Lite — System Health & Performance Diagnostics (PRD 6.6)
# Checks hardware profile, RAM, zram/swap, earlyoom, disk type & free space,
# I/O scheduler udev rules, per-user slice limits, failed systemd units,
# heavy background services, and top memory users. Supports human & --json output.

VERSION="0.1.0"
JSON_MODE=0
ROOT_DIR="${ALX_ROOT:-}"

PROC_MEMINFO="${ALX_PROC_MEMINFO:-/proc/meminfo}"
PROC_SWAPS="${ALX_PROC_SWAPS:-/proc/swaps}"
SYS_BLOCK="${ALX_SYS_BLOCK:-/sys/block}"

HEAVY_SERVICES=(
    "bluetooth.service"
    "cups.service"
    "cups-browsed.service"
    "ModemManager.service"
    "avahi-daemon.service"
)

CHECK_NAMES=()
CHECK_STATUSES=()
CHECK_DETAILS=()
CHECK_FIXES=()
FAIL_COUNT=0
WARN_COUNT=0

usage() {
    cat <<'EOF'
Usage: alx-doctor [OPTIONS]

Run Algothix OS (ALX) Lite health and performance diagnostics.

Options:
  --json         Output machine-readable JSON
  --root <dir>   Inspect an alternate root directory (for testing)
  -v, --version  Show version information
  -h, --help     Show this help message

Exit codes:
  0  No FAIL checks (all OK or WARN)
  1  One or more FAIL checks detected
  2  Invalid arguments
EOF
}

json_escape() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/}"
    s="${s//$'\t'/\\t}"
    printf '%s' "${s}"
}

add_check() {
    local name="$1"
    local status="$2"
    local detail="$3"
    local fix="${4:-}"

    CHECK_NAMES+=("${name}")
    CHECK_STATUSES+=("${status}")
    CHECK_DETAILS+=("${detail}")
    CHECK_FIXES+=("${fix}")

    if [ "${status}" = "FAIL" ]; then
        FAIL_COUNT=$((FAIL_COUNT + 1))
    elif [ "${status}" = "WARN" ]; then
        WARN_COUNT=$((WARN_COUNT + 1))
    fi
}

is_live_host() {
    [ -z "${ROOT_DIR}" ] && [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -v|--version)
            printf 'alx-doctor %s\n' "${VERSION}"
            exit 0
            ;;
        --json)
            JSON_MODE=1
            shift
            ;;
        --root)
            [ "$#" -ge 2 ] || { echo "alx-doctor: --root requires a directory" >&2; exit 2; }
            ROOT_DIR="${2%/}"
            shift 2
            ;;
        *)
            echo "alx-doctor: unknown option: $1" >&2
            exit 2
            ;;
    esac
done

# 1. Hardware profile
PROFILE_FILE="${ROOT_DIR}/etc/alx/profile"
if [ -r "${PROFILE_FILE}" ]; then
    PROFILE_VAL="$(head -n 1 "${PROFILE_FILE}" | tr -d '[:space:]')"
    if [ "${PROFILE_VAL}" = "alx-profile-low" ] || [ "${PROFILE_VAL}" = "alx-profile-mid" ]; then
        add_check "profile" "OK" "Active profile: ${PROFILE_VAL}" ""
    else
        add_check "profile" "FAIL" "Invalid profile value: ${PROFILE_VAL}" "sudo alx-tune"
    fi
else
    add_check "profile" "FAIL" "Missing /etc/alx/profile" "sudo alx-tune"
fi

# 2. RAM
if [ -r "${PROC_MEMINFO}" ]; then
    RAM_TOTAL_MB="$(awk '/^MemTotal:/ { printf "%d", int($2/1024) }' "${PROC_MEMINFO}")"
    RAM_AVAIL_MB="$(awk '/^MemAvailable:/ { printf "%d", int($2/1024) }' "${PROC_MEMINFO}")"
    [ -n "${RAM_AVAIL_MB}" ] || RAM_AVAIL_MB="${RAM_TOTAL_MB}"
    RAM_USED_MB=$((RAM_TOTAL_MB - RAM_AVAIL_MB))
    if [ "${RAM_AVAIL_MB}" -lt 96 ]; then
        add_check "ram" "FAIL" "Total ${RAM_TOTAL_MB} MiB, used ${RAM_USED_MB} MiB, available ${RAM_AVAIL_MB} MiB (critical)" "Close heavy apps or run sudo alx-tune"
    elif [ "${RAM_AVAIL_MB}" -lt 256 ]; then
        add_check "ram" "WARN" "Total ${RAM_TOTAL_MB} MiB, used ${RAM_USED_MB} MiB, available ${RAM_AVAIL_MB} MiB (low)" "Check top memory users below"
    else
        add_check "ram" "OK" "Total ${RAM_TOTAL_MB} MiB, used ${RAM_USED_MB} MiB, available ${RAM_AVAIL_MB} MiB" ""
    fi
else
    add_check "ram" "FAIL" "Cannot read ${PROC_MEMINFO}" ""
fi

# 3. zram / swap state
ZRAM_CONF="${ROOT_DIR}/etc/default/zramswap"
if [ -r "${PROC_SWAPS}" ] && grep -q '/dev/zram' "${PROC_SWAPS}"; then
    ZRAM_KB="$(awk '/\/dev\/zram/ { sum += $3 } END { printf "%d", sum + 0 }' "${PROC_SWAPS}")"
    ZRAM_MB=$((ZRAM_KB / 1024))
    add_check "zram" "OK" "zram active (${ZRAM_MB} MiB configured)" ""
elif [ -n "${ROOT_DIR}" ] && [ -r "${ZRAM_CONF}" ] && grep -q '^ALGO=zstd' "${ZRAM_CONF}"; then
    add_check "zram" "OK" "zram configured (zstd, offline root check)" ""
else
    add_check "zram" "FAIL" "zram swap is not active" "sudo alx-tune"
fi

# 4. earlyoom state
EARLYOOM_CONF="${ROOT_DIR}/etc/default/earlyoom"
if is_live_host; then
    if systemctl is-active earlyoom.service >/dev/null 2>&1; then
        add_check "earlyoom" "OK" "earlyoom.service is active" ""
    else
        add_check "earlyoom" "FAIL" "earlyoom.service is not active" "sudo systemctl enable --now earlyoom.service"
    fi
elif [ -r "${EARLYOOM_CONF}" ] && grep -q '^EARLYOOM_ARGS=' "${EARLYOOM_CONF}"; then
    add_check "earlyoom" "OK" "earlyoom configured (offline/container check)" ""
else
    add_check "earlyoom" "FAIL" "earlyoom is not configured" "sudo alx-tune"
fi

# 5. Disk type & free space
DISK_TYPE="SSD/virtual"
if [ -d "${SYS_BLOCK}" ]; then
    for dev in "${SYS_BLOCK}"/*; do
        [ -d "${dev}" ] || continue
        case "$(basename "${dev}")" in
            loop*|ram*|zram*|dm-*|sr*) continue ;;
        esac
        if [ -r "${dev}/queue/rotational" ] && [ "$(cat "${dev}/queue/rotational")" = "1" ]; then
            DISK_TYPE="HDD (rotational)"
            break
        fi
    done
fi

DISK_TARGET="${ROOT_DIR:-/}"; [ -d "${DISK_TARGET}" ] || DISK_TARGET="/"
DISK_AVAIL_MB="$(df -Pm "${DISK_TARGET}" | awk 'NR==2 { print $4 }')"
DISK_USE_PCT="$(df -Pm "${DISK_TARGET}" | awk 'NR==2 { gsub(/%/, "", $5); print $5 }')"
if [ "${DISK_AVAIL_MB}" -lt 512 ] || [ "${DISK_USE_PCT}" -ge 95 ]; then
    add_check "disk" "FAIL" "${DISK_TYPE}, ${DISK_AVAIL_MB} MiB free (${DISK_USE_PCT}% used)" "Run ncdu / and clear old caches"
elif [ "${DISK_AVAIL_MB}" -lt 2048 ] || [ "${DISK_USE_PCT}" -ge 85 ]; then
    add_check "disk" "WARN" "${DISK_TYPE}, ${DISK_AVAIL_MB} MiB free (${DISK_USE_PCT}% used)" "Run sudo apt autoremove && sudo apt clean"
else
    add_check "disk" "OK" "${DISK_TYPE}, ${DISK_AVAIL_MB} MiB free (${DISK_USE_PCT}% used)" ""
fi

# 6. I/O scheduler udev rule
UDEV_RULE="${ROOT_DIR}/etc/udev/rules.d/60-alx-io-scheduler.rules"
if [ -r "${UDEV_RULE}" ]; then
    add_check "io_scheduler" "OK" "udev rule present (bfq for HDD, none for SSD)" ""
else
    add_check "io_scheduler" "WARN" "Missing /etc/udev/rules.d/60-alx-io-scheduler.rules" "Reinstall alx-tune package"
fi

# 7. Per-user systemd slice resource limits
SLICE_CONF="${ROOT_DIR}/etc/systemd/system/user-.slice.d/50-alx-limits.conf"
if [ -r "${SLICE_CONF}" ] && grep -q '^MemoryMax=' "${SLICE_CONF}"; then
    MEM_MAX_VAL="$(awk -F= '/^MemoryMax=/ { print $2; exit }' "${SLICE_CONF}")"
    add_check "user_limits" "OK" "Per-user slice active (MemoryMax=${MEM_MAX_VAL})" ""
else
    add_check "user_limits" "FAIL" "Per-user resource limits drop-in missing" "sudo alx-tune"
fi

# 8. Failed systemd units
if is_live_host; then
    FAILED_UNITS="$(systemctl --failed --no-legend --plain 2>/dev/null | awk '{print $1}' | tr '\n' ' ' | sed 's/ $//')"
    if [ -z "${FAILED_UNITS}" ]; then
        add_check "systemd_failed" "OK" "0 failed systemd units" ""
    else
        add_check "systemd_failed" "FAIL" "Failed units: ${FAILED_UNITS}" "systemctl --failed"
    fi
else
    add_check "systemd_failed" "OK" "No systemd runtime (offline/container check)" ""
fi

# 9. Heavy background services
if is_live_host; then
    ACTIVE_HEAVY=()
    for svc in "${HEAVY_SERVICES[@]}"; do
        if systemctl is-active "${svc}" >/dev/null 2>&1; then
            ACTIVE_HEAVY+=("${svc}")
        fi
    done
    if [ "${#ACTIVE_HEAVY[@]}" -eq 0 ]; then
        add_check "heavy_services" "OK" "No heavy background services active" ""
    else
        add_check "heavy_services" "WARN" "Active: ${ACTIVE_HEAVY[*]}" "sudo alx-tune --disable ${ACTIVE_HEAVY[0]}"
    fi
else
    add_check "heavy_services" "OK" "No systemd runtime (offline/container check)" ""
fi

# 10. Top 5 memory users
TOP_PROCS=()
if command -v ps >/dev/null 2>&1; then
    while IFS= read -r line; do
        [ -n "${line}" ] && TOP_PROCS+=("${line}")
    done < <(ps -eo comm=,rss= --sort=-rss 2>/dev/null | head -n 5 | awk '{ printf "%s:%d\n", $1, int($2/1024) }')
fi

OVERALL="OK"
if [ "${FAIL_COUNT}" -gt 0 ]; then
    OVERALL="FAIL"
elif [ "${WARN_COUNT}" -gt 0 ]; then
    OVERALL="WARN"
fi

if [ "${JSON_MODE}" -eq 1 ]; then
    printf '{\n'
    printf '  "version": "%s",\n' "$(json_escape "${VERSION}")"
    printf '  "status": "%s",\n' "${OVERALL}"
    printf '  "fail_count": %d,\n' "${FAIL_COUNT}"
    printf '  "warn_count": %d,\n' "${WARN_COUNT}"
    printf '  "checks": [\n'
    for i in "${!CHECK_NAMES[@]}"; do
        comma=","
        [ "$i" -eq "$((${#CHECK_NAMES[@]} - 1))" ] && comma=""
        printf '    {"name": "%s", "status": "%s", "detail": "%s", "fix": "%s"}%s\n' \
            "$(json_escape "${CHECK_NAMES[$i]}")" \
            "$(json_escape "${CHECK_STATUSES[$i]}")" \
            "$(json_escape "${CHECK_DETAILS[$i]}")" \
            "$(json_escape "${CHECK_FIXES[$i]}")" \
            "${comma}"
    done
    printf '  ],\n'
    printf '  "top_memory": [\n'
    for i in "${!TOP_PROCS[@]}"; do
        comma=","
        [ "$i" -eq "$((${#TOP_PROCS[@]} - 1))" ] && comma=""
        proc_name="${TOP_PROCS[$i]%:*}"
        proc_mb="${TOP_PROCS[$i]##*:}"
        printf '    {"process": "%s", "rss_mb": %s}%s\n' \
            "$(json_escape "${proc_name}")" \
            "${proc_mb}" \
            "${comma}"
    done
    printf '  ]\n'
    printf '}\n'
else
    printf 'Algothix OS (ALX) Lite — System Doctor (v%s)\n' "${VERSION}"
    printf '%-16s %-6s %-44s %s\n' "CHECK" "STATE" "DETAILS" "SUGGESTED FIX"
    printf '%-16s %-6s %-44s %s\n' "----------------" "------" "--------------------------------------------" "-------------------------"
    for i in "${!CHECK_NAMES[@]}"; do
        printf '%-16s %-6s %-44s %s\n' \
            "${CHECK_NAMES[$i]}" \
            "${CHECK_STATUSES[$i]}" \
            "${CHECK_DETAILS[$i]}" \
            "${CHECK_FIXES[$i]}"
    done
    if [ "${#TOP_PROCS[@]}" -gt 0 ]; then
        printf '\nTop memory processes (RSS MiB):\n'
        for entry in "${TOP_PROCS[@]}"; do
            printf '  %-24s %s MiB\n' "${entry%:*}" "${entry##*:}"
        done
    fi
    printf '\nOverall status: %s (fail=%d, warn=%d)\n' "${OVERALL}" "${FAIL_COUNT}" "${WARN_COUNT}"
fi

if [ "${FAIL_COUNT}" -gt 0 ]; then
    exit 1
fi
exit 0
