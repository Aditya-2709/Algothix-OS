#!/usr/bin/env bash
set -euo pipefail

# ALX Assistant First-Run Setup Wizard (DESIGN.md terminal palette)
# Stores API key in GNOME Keyring via secret-tool when available, falling back
# to mode-0600 files (~/.config/alx-assistant/auth.json & ~/.gg/auth.json).
# Enforces safe defaults: allowActions=false, skipAllow=false, rawReadOnly=true, telemetry=false.

CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/alx-assistant"
SETTINGS_FILE="${CONFIG_DIR}/settings.json"
AUTH_FILE="${CONFIG_DIR}/auth.json"
HOTKEYS_FILE="${CONFIG_DIR}/hotkeys.env"
GG_DIR="${HOME}/.gg"
GG_AUTH_FILE="${GG_DIR}/auth.json"

# DESIGN.md ANSI accents (#3DDC97 mint -> 38;2;61;220;151, muted -> 38;2;138;148;163)
MINT='\033[38;2;61;220;151m'
MUTED='\033[38;2;138;148;163m'
BOLD='\033[1m'
RESET='\033[0m'

umask 077
mkdir -p "${CONFIG_DIR}" "${GG_DIR}"
chmod 700 "${CONFIG_DIR}" "${GG_DIR}"

printf "${MINT}${BOLD}============================================================${RESET}\n"
printf "${MINT}${BOLD}  ALX ASSISTANT — FIRST-RUN SETUP (CLOUD API)               ${RESET}\n"
printf "${MINT}${BOLD}============================================================${RESET}\n"
printf "${MUTED}  Requires internet + your own API key. No telemetry is sent.${RESET}\n"
printf "${MUTED}  Safe defaults: allowActions=false, rawReadOnly=true.${RESET}\n\n"

echo "Choose your cloud AI provider:"
echo "  1) Gemini (Google AI Studio — free tier available)"
echo "  2) Claude (Anthropic)"
echo "  3) ChatGPT (OpenAI)"
printf "Selection [1-3, default 1]: "
read -r choice
case "${choice:-1}" in
    1) PROVIDER="gemini" ;;
    2) PROVIDER="claude" ;;
    3) PROVIDER="openai" ;;
    *)
        echo "Invalid selection. Defaulting to gemini."
        PROVIDER="gemini"
        ;;
esac

printf "\nPaste your %s API key (input hidden): " "${PROVIDER}"
read -r -s API_KEY
echo ""
if [ -z "${API_KEY}" ]; then
    echo "No API key entered. Setup aborted; no files or network calls were made."
    exit 1
fi

printf "\nOptional second-brain notes folder path (leave blank to skip): "
read -r NOTES_DIR

# Store key in Secret Service keyring when available; always keep 0600 auth file for sidecar
KEY_STORAGE="file-0600"
if command -v secret-tool >/dev/null 2>&1; then
    if printf '%s' "${API_KEY}" | secret-tool store --label="ALX Assistant (${PROVIDER})" service alx-assistant key api_key provider "${PROVIDER}" 2>/dev/null; then
        KEY_STORAGE="keyring+file-0600"
    fi
fi

python3 - "${SETTINGS_FILE}" "${AUTH_FILE}" "${GG_AUTH_FILE}" "${PROVIDER}" "${API_KEY}" "${NOTES_DIR}" <<'PYEOF'
import json, os, sys

settings_path, auth_path, gg_auth_path, provider, api_key, notes_dir = sys.argv[1:7]

settings = {
    "product": "ALX Assistant",
    "allowActions": False,
    "skipAllow": False,
    "rawReadOnly": True,
    "telemetry": False,
    "autoUpdate": False,
    "provider": provider,
    "notesDir": notes_dir,
}
with open(settings_path, "w", encoding="utf-8") as f:
    json.dump(settings, f, indent=2)
    f.write("\n")
os.chmod(settings_path, 0o600)

auth_payload = {provider: {"apiKey": api_key}}
for path in (auth_path, gg_auth_path):
    with open(path, "w", encoding="utf-8") as f:
        json.dump(auth_payload, f, indent=2)
        f.write("\n")
    os.chmod(path, 0o600)
PYEOF

if [ ! -f "${HOTKEYS_FILE}" ]; then
    cat > "${HOTKEYS_FILE}" <<'EOF'
# ALX Assistant Awesome WM Hotkeys (conflict-free defaults)
ALX_ASSISTANT_TALK_KEY="i"
ALX_ASSISTANT_TYPE_KEY="i"
ALX_ASSISTANT_PANIC_KEY="Escape"
EOF
    chmod 600 "${HOTKEYS_FILE}"
fi

printf "\n${MINT}Setup complete.${RESET}\n"
echo "  Provider     : ${PROVIDER}"
echo "  Key storage  : ${KEY_STORAGE} (mode 0600)"
echo "  Settings     : ${SETTINGS_FILE} (allowActions=false, skipAllow=false, rawReadOnly=true, telemetry=false)"
echo "  Panic stop   : Mod4 + Shift + Escape (or 'alx-assistant --panic-stop')"
