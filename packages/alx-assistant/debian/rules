#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_install:
	dh_auto_install
	if [ -n "$$ALX_ASSISTANT_DIST_DIR" ] && [ -d "$$ALX_ASSISTANT_DIST_DIR" ]; then \
		install -d debian/alx-assistant/usr/lib/alx-assistant; \
		cp -a "$$ALX_ASSISTANT_DIST_DIR/." debian/alx-assistant/usr/lib/alx-assistant/; \
	fi
